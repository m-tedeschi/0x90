window-decoration = none
#window-decoration = auto
#macos-titlebar-style = hidden
link-previews = false

background = #000000
foreground = #e6e6e6
background-opacity = 0.75
background-blur = true
minimum-contrast = 1
scrollbar = never

window-padding-x = 6
window-padding-y = 4


window-width = 120
window-height = 36
window-position-x = 240
window-position-y = 185

font-family = "Hack Nerd Font"
font-size = 14

resize-overlay = never

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

palette = 0=#1b1b1b
palette = 1=#ff6b6b
palette = 2=#8bd450
palette = 3=#ffd166
palette = 4=#6ea8fe
palette = 5=#d291ff
palette = 6=#5eead4
palette = 7=#d9d9d9

palette = 8=#5a5a5a
palette = 9=#ff8787
palette = 10=#a6e36b
palette = 11=#ffe08a
palette = 12=#8bbcff
palette = 13=#e0a8ff
palette = 14=#7ef0e3
palette = 15=#ffffff

# Free up cmd+number if Ghostty already uses them
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind

# Send tmux prefix (Ctrl-b) + window number
keybind = cmd+one=text:\x02\x31
keybind = cmd+two=text:\x02\x32
keybind = cmd+three=text:\x02\x33
keybind = cmd+four=text:\x02\x34
keybind = cmd+five=text:\x02\x35
keybind = cmd+six=text:\x02\x36
keybind = cmd+seven=text:\x02\x37
keybind = cmd+eight=text:\x02\x38
keybind = cmd+nine=text:\x02\x39

